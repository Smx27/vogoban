{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "ServiceBus": {
      "FullyQualifiedNamespace": "vg-enterprise-servicebus.servicebus.windows.net",
      "OrderEventsTopic": "vg-order-events",
      "NotificationsSubscription": "vg-notifications",
      "NotificationRequestsQueue": "vg-notification-requests"
    },
    "Storage": {
      "BlobServiceUri": "https://vgentstorage.blob.core.windows.net/",
      "NotificationPayloadsContainer": "vg-notification-payloads"
    },
    "KeyVault": {
      "Enabled": false,
      "VaultUri": "https://vg-enterprise-kv.vault.azure.net/"
    },
    "Identity": {
      "ManagedIdentityClientId": "00000000-0000-0000-0000-000000000000"
    }
  },
  "Contracts": {
    "SchemaRoot": "../enterprise-contracts/contracts"
  },
  "ConnectionStrings": {
    "ServiceBus": "@Microsoft.KeyVault(SecretUri=https://vg-enterprise-kv.vault.azure.net/secrets/vg-servicebus-connection/)",
    "Cosmos": "@Microsoft.KeyVault(SecretUri=https://vg-enterprise-kv.vault.azure.net/secrets/vg-cosmos-connection/)",
    "Storage": "@Microsoft.KeyVault(SecretUri=https://vg-enterprise-kv.vault.azure.net/secrets/vg-storage-connection/)"
  },
  "Services": {
    "Customers": {
      "BaseUrl": "http://localhost:5182"
    }
  }
}
