{
  "name": "vogoban",
  "version": "0.18.0",
  "description": ".NET-first enterprise code and architecture graph engine",
  "type": "module",
  "private": true,
  "bin": {
    "vogoban": "./src/cli/main.ts"
  },
  "scripts": {
    "vogoban": "bun src/cli/main.ts",
